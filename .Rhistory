N=200000
bwt=rnorm(N,2200,700)
lowbwt=ifelse(bwt<1500,1,0)
barplot(table(lowbwt))
p=sum(lowbwt)/N
p
n=200
amostra=sample(lowbwt,size=n,replace=TRUE)
barplot(table(amostra))
pchapeu=sum(amostra)/n
pchapeu
nsim=1000
pchapeu=NULL
ep=NULL
for (i in 1:nsim){
amostra=sample(lowbwt,size=n,replace=TRUE)
pchapeu=c(pchapeu,mean(amostra))
ep=c(ep,sqrt(mean(amostra)*(1-mean(amostra))/n))
}
hist(pchapeu)
li=pchapeu-z*ep
ls=pchapeu+z*ep
#probabilidade de cobertura
pc=sum(ls>p&li<p)/nsim
pc
z=qnorm(0.975)
li=pchapeu-z*ep
ls=pchapeu+z*ep
#probabilidade de cobertura
pc=sum(ls>p&li<p)/nsim
pc
hist(pchapeu,prob=TRUE)
lines(seq(0,1,l=200),dnorm(seq(0,1,l=200),mean(pchapeu),sqrt(mean(pchapeu)*(1-mean(pchapeu))/n)))
nsim=100
li=li[1:nsim]
ls=ls[1:nsim]
plot(1:nsim,pchapeu[1:nsim],ylim=c(min(li[1:nsim]),max(ls[1:nsim])),xlab='Amostra',ylab='Intervalo de Confiança')
abline(h=p,lty=3)
segments(1:nsim,li,1:nsim,ls)
i=(ls>p&li<p)
segments((1:nsim)[!i],li[!i],(1:nsim)[!i],ls[!i],col=2)
dbinom(10,7,prob=0.8)
dbinom(10,7,p=0.8)
dbinom(7,10,0.8)
1/6
1/7
