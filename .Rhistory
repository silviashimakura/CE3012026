notas <- readxl::read_xls('notas-chamada.xls')
notas$`PROVA 1` <- round(as.numeric(notas$`PROVA 1`),1)
notas$`PROVA 2` <- round(as.numeric(notas$`PROVA 2`),1)
notas$`PROVA 3` <- round(as.numeric(notas$`PROVA 3`),1)
notas$`PROVA 4` <- round(as.numeric(notas$`PROVA 4`),1)
# notas$`REMOTA 1` <- round(as.numeric(notas$`REMOTA 1`),1)
# notas$`REMOTA 2` <- round(as.numeric(notas$`REMOTA 2`),1)
# notas$`REMOTA 3` <- round(as.numeric(notas$`REMOTA 3`),1)
# notas$`REMOTA 4` <- round(as.numeric(notas$`REMOTA 4`),1)
#notas$`REMOTA 5` <- round(as.numeric(notas$`REMOTA 5`),1)
# notas$`TRABALHO 1` <- as.numeric(notas$`TRABALHO 1`)
# notas$`TRABALHO 2` <- as.numeric(notas$`TRABALHO 2`)
# notas$`MÉDIA REMOTAS` <- rowSums(notas[,c('REMOTA 1',
#                                           'REMOTA 2',
#                                           'REMOTA 3',
#                                           'REMOTA 4'#,
#                                           #'REMOTA 5'#,
#                                           # 'TRABALHO 1',
#                                           # 'TRABALHO 2'
#                                           )],na.rm = T) /4
soma_parciais <- rowSums(notas[,c('PROVA 1', 'PROVA 2',
'PROVA 3', 'PROVA 4')],
na.rm = T)
menor_parcial <- pmin(
ifelse(is.na(notas$`PROVA 1`),0, notas$`PROVA 1`),
ifelse(is.na(notas$`PROVA 2`),0, notas$`PROVA 2`),
ifelse(is.na(notas$`PROVA 3`),0, notas$`PROVA 3`),
ifelse(is.na(notas$`PROVA 4`),0, notas$`PROVA 4`),
na.rm = T)
#pre_exame <- round((soma_parciais-menor_parcial)/4, 1)
pre_exame <- round(soma_parciais/4, 1)
i <- pre_exame==3.9
pre_exame[i] <- 4
notas$`NOTAS PRÉ EXAME` <- pre_exame
notas$`SITUAÇÃO PRÉ EXAME` <-
ifelse(notas$`NOTAS PRÉ EXAME` >= 7,
"APROVADO",
ifelse(notas$`NOTAS PRÉ EXAME` < 4,
"REPROVADO",
"EXAME"))
notas$`NOTAS FINAIS` <-
ifelse(notas$`SITUAÇÃO PRÉ EXAME` == 'EXAME',
ifelse(is.na(notas$EXAME),
round(notas$`NOTAS PRÉ EXAME`/2,1),
round((notas$`NOTAS PRÉ EXAME`+ notas$EXAME)/2, 1)),
notas$`NOTAS PRÉ EXAME`)
notas$`SITUAÇÃO FINAL` <-
ifelse(notas$`NOTAS FINAIS` >= 5,
"APROVADO",
"REPROVADO")
